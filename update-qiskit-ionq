#!/usr/bin/env bash
# Replay the Qollab patches (the commits on top of upstream qiskit-ionq) onto an
# upstream qiskit-ionq version tag, so this fork can track a new release.
#
#   ./update-qiskit-ionq 1.1.1
#
# Stops on conflict for manual resolution (run `git rebase --continue` after
# fixing). Never pushes — after a successful rebase AND a build-verify, force-push
# `main` yourself:  git push --force-with-lease origin HEAD:main
set -euo pipefail

[ $# -eq 1 ] || { echo "usage: $0 <qiskit-ionq-version>   e.g. $0 1.1.1" >&2; exit 2; }
# Upstream tags are v-prefixed (v1.1.1); accept the version with or without it
VERSION="v${1#v}"

git remote get-url upstream >/dev/null 2>&1 || \
  git remote add upstream https://github.com/qiskit-community/qiskit-ionq.git

# Fetch only the requested tag, force-updating just that ref. Avoids `--tags`, which
# exits non-zero when any pre-existing local tag "would clobber" — that would kill the
# script under `set -e`. A missing tag makes this fetch fail, which we report cleanly.
if ! git fetch --force upstream "refs/tags/${VERSION}:refs/tags/${VERSION}" 2>/dev/null; then
  echo "error: tag '${VERSION}' not found in upstream qiskit-ionq (https://github.com/qiskit-community/qiskit-ionq)" >&2
  exit 1
fi

# Our patches sit on top of some upstream main commit, not necessarily a release tag
# (the 1.0.2-era fork was based on main past v1.0.2). Upstream releases straight from
# main, with no stable branches, so the merge-base with upstream main is exactly where
# our patches start.
git fetch --force upstream main 2>/dev/null
BASE="$(git merge-base HEAD upstream/main)"
echo "Replaying $(git rev-list --count "${BASE}..HEAD") patches (since ${BASE:0:10}) onto ${VERSION}…"
git rebase --onto "${VERSION}" "${BASE}" HEAD

echo
echo "Rebased onto ${VERSION}. Next: build-verify the wheel, then land with:"
echo "  git push --force-with-lease origin HEAD:main"
